<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="synolsis_frame_skip_title">Frame skipping (apresentação)</string>
    <string name="synolsis_frame_skip_summary">Pula somente quadros exibidos, sem acelerar a CPU/GPU do jogo. Pode causar engasgos ou tremores; desativado por padrão.</string>
    <string-array name="synolsis_frame_skip_entries">
        <item>Desligado (recomendado)</item>
        <item>Pular 1 de 2 quadros</item>
        <item>Pular 2 de 3 quadros</item>
    </string-array>
    <integer-array name="synolsis_frame_skip_values">
        <item>0</item>
        <item>1</item>
        <item>2</item>
    </integer-array>
    <string name="synolsis_present_mode_title">Modo de apresentação Vulkan</string>
    <string name="synolsis_present_mode_summary">Padrão automático, FIFO com VSync, Mailbox de baixa latência ou Immediate (pode causar tearing). Se indisponível, usa FIFO. Reinicie o jogo.</string>
    <string-array name="synolsis_present_mode_entries">
        <item>Automático (padrão do Strato)</item>
        <item>FIFO (VSync)</item>
        <item>Mailbox (baixa latência)</item>
        <item>Immediate (sem VSync; experimental)</item>
    </string-array>
    <integer-array name="synolsis_present_mode_values">
        <item>0</item>
        <item>1</item>
        <item>2</item>
        <item>3</item>
    </integer-array>
</resources>