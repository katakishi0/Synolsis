<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="synolsis_frame_skip_title">Presentation frame skipping</string>
    <string name="synolsis_frame_skip_summary">Skips host output frames without speeding up the game CPU or GPU. May cause stutter; off by default.</string>
    <string-array name="synolsis_frame_skip_entries">
        <item>Off (recommended)</item>
        <item>Skip 1 out of 2 frames</item>
        <item>Skip 2 out of 3 frames</item>
    </string-array>
    <integer-array name="synolsis_frame_skip_values">
        <item>0</item>
        <item>1</item>
        <item>2</item>
    </integer-array>
    <string name="synolsis_present_mode_title">Vulkan presentation mode</string>
    <string name="synolsis_present_mode_summary">Auto, FIFO (VSync), Mailbox or Immediate (may tear). Unsupported modes fall back to FIFO. Restart the game.</string>
    <string-array name="synolsis_present_mode_entries">
        <item>Automatic (Strato default)</item>
        <item>FIFO (VSync)</item>
        <item>Mailbox (low latency)</item>
        <item>Immediate (no VSync; experimental)</item>
    </string-array>
    <integer-array name="synolsis_present_mode_values">
        <item>0</item>
        <item>1</item>
        <item>2</item>
        <item>3</item>
    </integer-array>
    <string name="synolsis_shader_threads_title">Vulkan pipeline compiler threads</string>
    <string name="synolsis_shader_threads_summary">Limits the number of parallel Vulkan pipeline compiler workers. More workers can use more RAM or cause stutter.</string>
    <string-array name="synolsis_shader_threads_entries">
        <item>Automatic (Strato default)</item>
        <item>1 thread (compatibility)</item>
        <item>2 threads (lower RAM use)</item>
        <item>4 threads (experimental)</item>
    </string-array>
    <integer-array name="synolsis_shader_threads_values">
        <item>0</item>
        <item>1</item>
        <item>2</item>
        <item>4</item>
    </integer-array>
</resources>